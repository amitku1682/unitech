# =========================================================================
# UNITECH CCTV — Environment Configuration Template
# =========================================================================
# Copy this file to '.env' and fill in your values.
# NEVER commit the actual '.env' file containing real secrets to version control.
# =========================================================================

# Database Connection (PostgreSQL 16+)
# For Docker Compose, the database host is 'unitech-db'. For local host, use 'localhost'.
DATABASE_URL=postgres://unitech_admin:your_secure_password_here@localhost:5432/unitech_cctv_db
DATABASE_SSL=false

# Docker Compose Service Environment Variables
POSTGRES_USER=unitech_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=unitech_cctv_db

# Cryptographic Session Secret (min 32 bytes / 64 hex characters)
ADMIN_SESSION_SECRET=your_random_64_character_hex_session_secret_key_here

# Settings Encryption Key for sensitive configs at rest (AES-256-GCM SMTP passwords)
SETTINGS_ENCRYPTION_KEY=your_random_32_byte_hex_or_passphrase_key_here

# Application Configuration
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Public Site Base URL (used for password reset email links and external references)
# Set to your server IP/domain (e.g. http://<your-server-ip>) or production domain (https://unitechcctv.com)
APP_BASE_URL=https://unitechcctv.com
NEXT_PUBLIC_BASE_URL=https://unitechcctv.com

# Admin Session Cookie Security
# Set to 'false' ONLY for plain HTTP staging/testing environments (e.g. http://<your-server-ip>).
# MUST be set to 'true' (or omitted) in production once HTTPS/TLS is enabled.
COOKIE_SECURE=true

# Optional Integrations (leave empty if not configured)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
